rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Pair codes directory
    match /pair_codes/{secretCode} {
      // Allow getting a single pair code document by exact ID (no listing all codes)
      allow get: if isValidId(secretCode);
      allow list: if false;

      // Female owner creates pairing code upon account setup
      allow create: if isSignedIn()
        && isValidId(secretCode)
        && request.resource.data.code == secretCode
        && request.resource.data.femaleUid == request.auth.uid;

      // Male companion updates code when connecting with his name
      allow update: if isValidId(secretCode)
        && (
          (isSignedIn() && resource.data.femaleUid == request.auth.uid)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maleConnected', 'maleName'])
            && request.resource.data.maleName is string
            && request.resource.data.maleName.size() <= 100
          )
        );

      allow delete: if isSignedIn() && resource.data.femaleUid == request.auth.uid;
    }

    // Female user accounts
    match /female_users/{femaleUid} {
      allow get: if isValidId(femaleUid)
        && (isOwner(femaleUid) || resource.data.secretCode is string);
      
      allow list: if isSignedIn() && request.auth.uid == femaleUid;

      allow create: if isSignedIn()
        && request.auth.uid == femaleUid
        && request.resource.data.uid == femaleUid;

      // Female owner can update profile & cycle settings.
      // Male companion can update partnerName & partnerConnected state.
      allow update: if isValidId(femaleUid)
        && (
          isOwner(femaleUid)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerConnected', 'partnerName', 'partnerConnectedAt', 'updatedAt'])
            && request.resource.data.partnerName is string
            && request.resource.data.partnerName.size() <= 100
          )
        );

      allow delete: if isOwner(femaleUid);

      // Cycles subcollection
      match /cycles/{cycleId} {
        allow read: if isValidId(femaleUid) && isValidId(cycleId);
        allow write: if isOwner(femaleUid) && isValidId(cycleId);
      }

      // Daily symptom logs subcollection
      match /daily_logs/{dateStr} {
        allow read: if isValidId(femaleUid) && isValidId(dateStr);
        // Female owner can log; companion can also help record if connected
        allow write: if isValidId(femaleUid)
          && isValidId(dateStr)
          && (isOwner(femaleUid) || get(/databases/$(database)/documents/female_users/$(femaleUid)).data.partnerConnected == true);
      }
    }
  }
}
